{
  "manifest_version": 3,
  "name": "PokerNow GTO HUD",
  "version": "1.0.0",
  "description": "실시간 9-Max GTO 프리플랍 가이드 및 포스트플랍 승률 기반 액션 추천 HUD",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.pokernow.club/*",
    "*://pokernow.club/*",
    "*://*.pokernow.com/*",
    "*://pokernow.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.pokernow.club/*",
        "*://pokernow.club/*",
        "*://*.pokernow.com/*",
        "*://pokernow.com/*"
      ],
      "js": [
        "hand-evaluator.js",
        "equity-calculator.js",
        "gto-ranges.js",
        "position-detector.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ]
}